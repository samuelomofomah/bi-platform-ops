# Copy to .env for local runs. In CI these come from Jenkins credentials /
# GitHub environment secrets. Never commit real values.
BIOPS_ENV=dev
BIOPS_MOCK=1                     # 1 = no real servers needed; remove to go live
BIOPS_DB=biops.db
BIOPS_BACKUP_DIR=backups
BIOPS_S3_BUCKET=                 # optional: copy backups to S3
BIOPS_SNS_TOPIC_ARN=             # optional: alert on failed health checks

TABLEAU_URL=https://tableau.example.com
TABLEAU_SITE=                    # contentUrl; blank = Default site
TABLEAU_PAT_NAME=biops
TABLEAU_PAT_SECRET=
TABLEAU_BACKUP_PROJECT=          # optional: back up one project only
TABLEAU_REFRESH_DATASOURCES=     # comma-separated data source ids

MSTR_URL=https://mstr.example.com/MicroStrategyLibrary
MSTR_USER=svc_biops
MSTR_PASSWORD=
MSTR_LOGIN_MODE=1                # 1 standard, 16 LDAP, 8 guest
MSTR_CLUSTER_CHECK=1             # 0 = skip the cluster monitor (needs an admin privilege)
MSTR_REFRESH_CUBES=              # comma-separated projectId:cubeId
